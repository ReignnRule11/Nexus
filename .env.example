# Copy this file to .env.local and fill in values when a later phase requires them.
# Never put real credentials in this file. Never commit .env or .env.local.

# PostgreSQL connection string.
# Required for Prisma migrations and database access. Leave empty until a real database is available.
DATABASE_URL=""

# Session HMAC and CSRF secret.
# Required for authentication. Use a random string of at least 32 characters.
# Leave empty until a real secret is available. Never commit the real value.
AUTH_SECRET=""

# Optional user-provided LLM configuration.
# Supply your own values. Do not copy agent or platform environment keys.
USER_LLM_API_KEY=""
USER_LLM_BASE_URL=""
USER_LLM_MODEL=""
