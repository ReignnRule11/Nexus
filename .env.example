# Copy this file to .env.local and fill in values when a later phase requires them.
# Never put real credentials in this file. Never commit .env or .env.local.

# PostgreSQL connection string.
# Required for Prisma migrations and database access. Leave empty until a real database is available.
DATABASE_URL=""

# Session HMAC and CSRF secret.
# Required for authentication. Use a random string of at least 32 characters.
# Leave empty until a real secret is available. Never commit the real value.
AUTH_SECRET=""

# Private object storage. Production media requires STORAGE_DRIVER=s3 and the S3_* values.
# Leave empty until a real private bucket is available. Never commit real credentials.
# Do not use local filesystem, memory, public buckets, or fake storage in production.
STORAGE_DRIVER=""
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Optional user-provided LLM configuration.
# Supply your own values. Do not copy agent or platform environment keys.
# Required together when the AI Social Agent is used: USER_LLM_API_KEY, USER_LLM_BASE_URL, USER_LLM_MODEL.
# USER_LLM_PROVIDER defaults to openai-compatible. Timeout and max output tokens use documented safety bounds when empty.
USER_LLM_API_KEY=""
USER_LLM_BASE_URL=""
USER_LLM_MODEL=""
USER_LLM_PROVIDER=""
USER_LLM_TIMEOUT_MS=""
USER_LLM_MAX_OUTPUT_TOKENS=""
