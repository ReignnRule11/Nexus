# Copy this file to .env.local and fill in values when a later phase requires them.
# Never put real credentials in this file. Never commit .env or .env.local.

# PostgreSQL connection string.
# Required when database access is implemented. Leave empty until then.
DATABASE_URL=

# Session signing secret.
# Required when authentication is implemented. Leave empty until then.
AUTH_SECRET=

# Optional user-provided LLM configuration.
# Supply your own values. Do not copy agent or platform environment keys.
USER_LLM_API_KEY=
USER_LLM_BASE_URL=
USER_LLM_MODEL=
